#!name=去广告② 备选·仅自维护 App 规则（需证书）
#!desc=只含自维护的 App 路径规则，用于排查；需 HTTPS 解密；与其他「去广告②」模块只开一个
#!category=去广告
#!system=ios
# SPDX-License-Identifier: GPL-3.0-only; see LICENSE and THIRD_PARTY_NOTICES.md

[Rule]
AND,((URL-REGEX,^http://[0-9.:]+/amdc/mobileDispatch),(USER-AGENT,%E9%97%B2%E9%B1%BC*)),REJECT

[URL Rewrite]
# 淘宝 (taobao); 真机效果未验证
^https?://acs\.m\.taobao\.com/gw/mtop\.alibaba\.advertisementservice\.getadv(?:/|\?|$) - reject-dict
# 京东 (jd); 真机效果未验证
^https?://api\.m\.jd\.com/client\.action\?(?:[^#]*&)?functionId=(?:xview2Config|queryMaterialAdverts)(?:&|$) - reject-200
# 小红书 (xiaohongshu); 真机效果未验证
^https?://edith\.xiaohongshu\.com/api/sns/v\d+/system_service/splash_config(?:\?|$) - reject-dict
# 美团 (meituan); 真机效果未验证
^https?://sqt\.meituan\.com/s/gateway/mweb/api/marketingResource/show(?:\?|$) - reject-dict
# 知乎 (zhihu); 真机效果未验证
^https?://api\.zhihu\.com/commercial_api/(?:launch_v\d+|real_time_launch_v\d+)(?:/|\?|$) - reject-dict
# 闲鱼 (xianyu); 真机效果未验证
^https?://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlecommerce\.splash(?:/|\?|$) - reject-dict
# 高德地图 (amap); 真机效果未验证
^https?://amap-aos-info-nogw\.amap\.com/ws/aos/alimama/splash_screen_rt(?:\?|$) - reject-dict
^https?://m\d+\.amap\.com/ws/shield/dsp/app/startup/init(?:\?|$) - reject-dict
# 哔哩哔哩 (bilibili); 真机效果未验证
^https?://api\.bilibili\.com/x/mengqi/v\d+/resource(?:\?|$) - reject-dict
# 拼多多 (pdd); 真机效果未验证
^https?://api\.(?:pinduoduo|yangkeduo)\.com/api/cappuccino/splash(?:\?|$) - reject-dict
# 菜鸟 (cainiao); 真机效果未验证
^https?://cn-acs\.m\.cainiao\.com/gw/mtop\.cainiao\.adkeyword\.get\.cn(?:/|\?|$) - reject-dict
# Keep (keep); 真机效果未验证
^https?://api\.gotokeep\.com/ads/v\d/ads/preload(?:\?|$) - reject
# 携程 (ctrip); 真机效果未验证
^https?://m\.ctrip\.com/restapi/soa2/13916/json/tripAds(?:\?|$) - reject-200
# AppSo (appso); 真机效果未验证
^https?://sso\.ifanr\.com/jiong/IOS/appso/splash/ - reject
# Jump (jump); 真机效果未验证
^https://switch\.jumpvg\.com/jump/getlaunchad/ - reject-dict
^https://switch\.jumpvg\.com/jump/ad/ - reject-dict
^https://switch\.jumpvg\.com/jump/recommend/ad_conf(?:\?|$) - reject-dict
^https://switch\.jumpvg\.com/jump/notice/popup(?:\?|$) - reject-dict
# 虎牙 (huya); 真机效果未验证
^https://diy-assets\.msstatic\.com/hyys/activity/ - reject-img

[MITM]
hostname = %APPEND% acs.m.goofish.com, acs.m.taobao.com, amap-aos-info-nogw.amap.com, api.bilibili.com, api.gotokeep.com, api.m.jd.com, api.pinduoduo.com, api.yangkeduo.com, api.zhihu.com, cn-acs.m.cainiao.com, diy-assets.msstatic.com, edith.xiaohongshu.com, g-acs.m.goofish.com, m*.amap.com, m.ctrip.com, sqt.meituan.com, sso.ifanr.com, switch.jumpvg.com
