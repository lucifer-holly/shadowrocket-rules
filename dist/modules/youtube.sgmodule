#!name=去广告④ YouTube（实验，需证书）
#!desc=去除 YouTube App 视频贴片和首页、搜索里的广告；脚本来自 Maasea/sgmodule（Apache-2.0），已审核并固定版本；YouTube 异常时先关闭本模块
#!category=去广告
#!system=ios
# SPDX-License-Identifier: GPL-3.0-only; see LICENSE and THIRD_PARTY_NOTICES.md

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT-NO-DROP

[Script]
youtube-response = type=http-response,pattern=^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config)(?:\?|$),requires-body=true,binary-body-mode=true,max-size=2097152,timeout=20,script-path=https://raw.githubusercontent.com/lucifer-holly/shadowrocket-rules/main/dist/scripts/youtube.response.f98483d5f5017514f82502253c0db5ce2d4ffb7839887aa2cadc22666f5a7f12.js

[MITM]
hostname = %APPEND% youtubei.googleapis.com
