#!name=去广告⑥ 微信公众号文章（实验，需证书）
#!desc=隐藏公众号文章里的广告位（文末、文中、赞助、评论区和商品推广卡片），并删掉文章广告数据；朋友圈广告卡片网络规则改不了；需 HTTPS 解密与本机证书模块；文章打不开时先关闭本模块
#!category=去广告
#!system=ios
# SPDX-License-Identifier: GPL-3.0-only; see LICENSE and THIRD_PARTY_NOTICES.md

[URL Rewrite]
^https://mp\.weixin\.qq\.com/mp/cps_product_info\?action= - reject-dict

[Script]
wechat-article = type=http-response,pattern=^https://mp\.weixin\.qq\.com/s(?:/|\?),requires-body=true,max-size=5242880,timeout=10,script-path=https://raw.githubusercontent.com/lucifer-holly/shadowrocket-rules/main/dist/scripts/wechat.c8a6a6dd2790ea729bd9fa5f4f9b0efc6fc7111f306c4f6641ed10690a774b1a.js
wechat-ad = type=http-response,pattern=^https://mp\.weixin\.qq\.com/mp/getappmsgad(?:\?|$),requires-body=true,max-size=1048576,timeout=5,script-path=https://raw.githubusercontent.com/lucifer-holly/shadowrocket-rules/main/dist/scripts/wechat.c8a6a6dd2790ea729bd9fa5f4f9b0efc6fc7111f306c4f6641ed10690a774b1a.js

[MITM]
hostname = %APPEND% mp.weixin.qq.com
