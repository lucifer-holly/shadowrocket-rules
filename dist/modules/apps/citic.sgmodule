[URL Rewrite]
# 中信银行 (citic); 真机效果未验证
^https?://wap\.citicbank\.cn(?::\d+)?/NMBFOServer/cbframework\.do\?(?:[^#]*&)?act=CUBEPAGEDATA(?:&|$) - reject-200

[MITM]
hostname = %APPEND% wap.citicbank.cn
